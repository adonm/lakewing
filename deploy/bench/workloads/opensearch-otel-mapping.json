{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "refresh_interval": "5s"
  },
  "mappings": {
    "properties": {
      "timestamp_nanos": { "type": "date", "format": "epoch_second" },
      "severity_text": { "type": "keyword" },
      "service_name": { "type": "keyword" },
      "body": { "properties": { "message": { "type": "text" } } },
      "attributes": {
        "properties": {
          "host": { "type": "keyword" },
          "duration_ms": { "type": "integer" }
        }
      }
    }
  }
}
