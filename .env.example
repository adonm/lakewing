# Settings for `just rig-*`. Copy to ignored `.env` and fill in your values.
RIG_AWS_PROFILE=YOUR_PROFILE
RIG_AWS_REGION=YOUR_REGION
RIG_ENVIRONMENT=benchmark
RIG_AWS_ACCOUNT=YOUR_ACCOUNT_ID
RIG_VPC_TAG=YOUR_VPC_NAME_TAG
RIG_DB_SUBNET_A_TAG=YOUR_PRIVATE_SUBNET_A_NAME_TAG
RIG_DB_SUBNET_B_TAG=YOUR_PRIVATE_SUBNET_B_NAME_TAG
RIG_SSH_SG=YOUR_SSH_GROUP_ID
RIG_DB_CLIENT_SG=YOUR_DB_CLIENT_GROUP_ID
RIG_AURORA_SG=YOUR_AURORA_GROUP_ID
RIG_INSTANCE_TYPE=m7i.4xlarge
RIG_ROOT_GIB=250
RIG_SSH_USER=ec2-user
RIG_SSH_KEY=.tmp/pgvs3/rig-key.pem
