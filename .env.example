# Settings for the AWS benchmark rig (`just rig*`). Copy to .env (gitignored)
# and fill in. `just rig` also copies .env to the rig, whose side of the job
# needs the Aurora login.

# AWS CLI profile and region of the rig (log in first, e.g. `aws sso login`).
RIG_AWS_PROFILE=my-profile
RIG_AWS_REGION=us-east-2

# EC2 instance that runs DuckDB and the gateway, and how to SSH to it.
RIG_INSTANCE=i-0123456789abcdef0
RIG_SSH_USER=ec2-user
RIG_SSH_KEY=.tmp/pgvs3/rig-key.pem
# EC2 key pair name (only used by `just rig-teardown`).
RIG_KEY_PAIR=pgvs3-rig-key

# Aurora PostgreSQL cluster (teardown), its writer endpoint and login. Put
# the writer in the EC2 instance's AZ: a cross-AZ round trip costs ~7x more.
RIG_DB_CLUSTER=pgvs3-rig
RIG_PG_HOST=pgvs3-rig.cluster-xxxxxxxxxxxx.us-east-2.rds.amazonaws.com
RIG_PG_USER=pgvs3admin
RIG_PG_PASSWORD=change-me
